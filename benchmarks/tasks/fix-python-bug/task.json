{
  "name": "fix-python-bug",
  "description": "Fix a failing test in a small Python project",
  "category": "debugging",
  "capability": "tdd-workflow",
  "difficulty": "basic",
  "timeout": 120,
  "scoring": "binary",
  "metrics": ["correctness", "cost", "duration", "token_efficiency"],
  "expected_complexity": {
    "max_files": 2,
    "max_classes": 0,
    "max_functions": 3,
    "max_lines": 30,
    "disallow_patterns": ["ABC", "abstractmethod", "Factory"]
  }
}
